{
  "name": "storybound-rpg",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "General-purpose AI Game Master RPG with Chinese and English stories / 通用 AI 跑团 RPG，支持中英文故事",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test",
    "check": "node --check server.mjs && node --check public/app.js && node --test",
    "build": "node scripts/build-cloud.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "esbuild": "^0.28.2"
  },
  "license": "MIT"
}
